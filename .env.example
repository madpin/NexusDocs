# Copy to .env and fill in values you actually want to override.

# ---------------------------------------------------------------------------
# Repository backend: "memory" (default for dev) or "neo4j" (compose default).
# ---------------------------------------------------------------------------
REPOSITORY_BACKEND=neo4j

# ---------------------------------------------------------------------------
# Neo4j credentials. The compose stack creates the database with these.
# ---------------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexusdocs

# ---------------------------------------------------------------------------
# OpenAI. Leave OPENAI_API_KEY empty to fall back to the deterministic mock
# client. Set it for real LLM-driven assembly + extraction.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Point at any OpenAI-compatible endpoint
# (Azure OpenAI, Ollama, vLLM, LM Studio, OpenRouter, ...).
# Leave blank to use api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1
